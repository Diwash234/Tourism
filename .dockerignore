# Environment
.env
.env.local
.env.*.local

# Docker
Dockerfile
Dockerfile.ml
docker-compose.yml
.dockerignore

# Documentation
docs/
*.md

# Reports
reports/

# Misc archives (must stay above the downloads negations: last match wins)
*.zip
*.tar
*.rar

# Downloads: keep only the seed database + checksums the Dockerfile COPYs
downloads/*
!downloads/nepal-tourism-seed.sqlite3.gz
!downloads/nepal-tourism-seed.sqlite3.gz.sha256

# Virtual environments
venv/
.venv/

# Test results
test-results/
tests-nav/

# ML service: ship code + models + processed_data, never runtime artifacts
# or secrets (plain patterns like __pycache__/.env only match the context
# root, so the nested copies need their own globs).
ml_service/logs/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env
!ml_service/.env.example
