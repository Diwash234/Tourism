# ============================================================================
# Copy to `.env` for local development, or set these as Environment Variables
# in the Render web service. NEVER commit a filled-in copy: `.env` is ignored.
#
# Every value below is a placeholder. Put real secrets only in Render's
# dashboard (or your local, git-ignored .env).
# ============================================================================

# --- Required in production -------------------------------------------------
# Copy the INTERNAL Database URL from Render -> tourism_db -> Connect.
# Leave this UNSET locally, so Django keeps using SQLite (Tourism/db.sqlite3).
# DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DBNAME
#
# Only needed for the EXTERNAL URL; the internal Render network is plain TCP
# and must NOT be asked for SSL.
# DATABASE_SSLMODE=require

# Generate your own: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Comma-separated. On Render this is your service hostname, e.g.
# ALLOWED_HOSTS=my-tourism-api.onrender.com
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Core behaviour ----------------------------------------------------------
DEBUG=False

# The React frontend's origin(s), so the browser will accept API responses.
# Comma-separated. Do NOT use CORS_ALLOW_ALL_ORIGINS in production.
# CORS_ALLOWED_ORIGINS=https://my-tourism-frontend.onrender.com
# CORS_ALLOWED_ORIGIN_REGEXES=

# --- Optional ---------------------------------------------------------------
# Reuse DB connections between requests (seconds). Good for PostgreSQL.
# CONN_MAX_AGE=600

# Render's filesystem is ephemeral. Point MEDIA_ROOT at a Render Disk mount to
# keep admin-uploaded images across deploys. Leave unset locally.
# MEDIA_ROOT=/var/data/media

# With DEBUG=False nothing serves MEDIA_ROOT unless this is on, so
# admin-uploaded images would 404. Fine for one small instance; for real
# traffic use object storage/CDN instead.
# SERVE_MEDIA=True

# --- Other services the app talks to (already configured for local dev) -----
# ROUTING_BASE_URL=https://router.project-osrm.org
# ROUTING_PROFILES=driving
# ML_SERVICE_URL=http://127.0.0.1:8001
# IMAGE_SERVER_URL=http://127.0.0.1:8002
