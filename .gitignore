#################################
# ENVIRONMENT VARIABLES
#################################

.env
.env.*
!.env.example

#################################
# PYTHON
#################################

__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
env/
.venv/
ENV/

# Python build files
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

#################################
# DJANGO BACKEND
#################################

# Django local database
db.sqlite3
db.sqlite3-journal

# Django static/media
staticfiles/
media/

# Logs
*.log

#################################
# REACT FRONTEND
#################################

# Node dependencies
node_modules/

# React builds
build/
dist/

# Vite cache
.vite/

# Environment files
frontend/**/.env
frontend/**/.env.*

# Keep example env
frontend/**/.env.example

#################################
# IDE FILES
#################################

.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

#################################
# ML SERVICE
#################################

# Python cache
ml-service/**/__pycache__/

# Virtual environment
ml-service/venv/
ml-service/.venv/

#################################
# ML DATASETS
#################################

# Raw datasets can be huge
ml-service/data/images/raw/
ml-service/data/routes/*.osm.pbf

# Generated datasets
ml-service/processed_data/

#################################
# MACHINE LEARNING MODELS
#################################

# Large trained models
*.joblib
*.pkl
*.pt
*.pth

# Keep model folders but not large binaries
ml-service/model/**/model/
ml-service/model/**/*.joblib
ml-service/model/**/*.pt

#################################
# LOGS
#################################

logs/
ml-service/logs/*

#################################
# JUPYTER
#################################

.ipynb_checkpoints/

#################################
# TEMP FILES
#################################

*.tmp
*.temp
*.bak
*.swp

# Firebase service account (secret)
firebase/serviceAccountKey.json

# Local virtual environments
.venv/
venv/

# Build outputs
frontend/Tourism/dist/
Tourism/staticfiles/

# Note: Tourism/db.sqlite3 IS tracked (seeding snapshot with ~6.4k destinations
# and ~31k image rows) so a fresh clone has data to browse. It is ~21MB (well
# under GitHub's 100MB limit). If you grow it substantially (e.g. by running
# download_ai_images and saving local files), add it back to .gitignore to
# avoid pushing huge DBs.
# Tourism/db.sqlite3  (intentionally NOT ignored)
Tourism/db.sqlite3.gz

#################################
# STANDALONE IMAGE SERVER DATASET
#################################

# The 100k+ tourism image dataset must NEVER be committed to Git.
# image-server/ contains code/config only; the images live on disk / a
# shared drive / an external host and are served statically (dev: python -m
# http.server, prod: Nginx). See docs/IMAGE_SERVER.md.
# ignore every file inside the dataset tree (any depth)...
image-server/images/*
image-server/images/**/*
# ...but keep the placeholder files and let Git descend into the dirs
!image-server/images/**/
!image-server/images/**/.gitkeep

#################################
# DOWNLOADS (keep repo small)
#################################
# Only the compressed DB snapshot is tracked in downloads/.
# The uncompressed copy, the images zip and the full-project zip are
# regenerable from the committed DB + source; ignore them so the repo
# doesn't grow past ~50MB.
downloads/nepal-tourism-database.sqlite3
downloads/nepal-images-only.zip
downloads/nepal-tourism-full-project.zip
