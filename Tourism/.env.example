# =====================================================================
# Digital Nepal Tourism Platform — Comprehensive Environment Config (.env.example)
# All APIs below are optional free-tier/open-data services.
# The application operates with 100% resilience even if keys are unconfigured.
# =====================================================================

# 0. Django runtime and production transport security
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=SAMEORIGIN
# In production set DEBUG=False; secure defaults then enable HTTPS redirects,
# secure cookies, one-year HSTS, and X_FRAME_OPTIONS=DENY automatically.

# 0b. Database — SQLite is the zero-setup DEFAULT (WAL-hardened at runtime,
# production-viable on a single node). For multi-instance production point
# the same code at PostgreSQL; nothing else changes:
#   DATABASE_URL=postgres://tourism_user:secret@db-host:5432/tourism_db
#   DATABASE_URL=sqlite:///absolute/path/to/db.sqlite3
# Precedence: DATABASE_URL > DB_ENGINE + DB_* below > default SQLite.
# DB_ENGINE=postgres
# DB_NAME=tourism_db
# DB_USER=tourism_user
# DB_PASSWORD=tourism_pass
# DB_HOST=localhost
# DB_PORT=5432
# If Postgres client tools (pg_dump/psql/createdb/dropdb, used by the
# backup/restore commands) are not on PATH, set their full paths:
# PG_DUMP=/usr/lib/postgresql/18/bin/pg_dump
# PG_PSQL=/usr/lib/postgresql/18/bin/psql
# PG_CREATEDB=/usr/lib/postgresql/18/bin/createdb
# PG_DROPDB=/usr/lib/postgresql/18/bin/dropdb

# 1. Image Acquisition Providers (Multi-Source Pipeline)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key
PEXELS_API_KEY=your_pexels_api_key
FLICKR_API_KEY=your_flickr_api_key
PIXABAY_API_KEY=your_pixabay_api_key
OPENVERSE_API_KEY=your_openverse_api_key

# 2. AI / LLM Translation & Chatbot Providers (Free-Tier Compatible)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
TOGETHER_API_KEY=your_together_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# 3. Mapping, Weather & Geo APIs
OPENWEATHER_API_KEY=your_openweather_api_key
MAPILLARY_ACCESS_TOKEN=your_mapillary_access_token
FOURSQUARE_API_KEY=your_foursquare_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 4. Authentication, Messaging & Push Notifications (Optional)
#
# --- EMAIL VERIFICATION (real delivery) --------------------------------
# Default backend is CONSOLE: verification/reset emails are generated and
# "sent" to the server log (great for development — read them there).
#
# To deliver REAL emails (Gmail example) set:
#   1. Gmail account: Google Account → Security → 2-Step Verification →
#      App passwords → generate one (16 characters, no spaces).
#   2. Put in THIS .env:
#      EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#      EMAIL_HOST=smtp.gmail.com
#      EMAIL_PORT=587
#      EMAIL_USE_TLS=True
#      EMAIL_HOST_USER=youraddress@gmail.com
#      EMAIL_HOST_PASSWORD=your-16-char-app-password
#      DEFAULT_FROM_EMAIL=youraddress@gmail.com
#   3. Restart the API. Every "Verify your email" / reset link now lands in
#      the user's real inbox.
# Any other SMTP provider works too (Mailgun, SES, custom) — swap the four
# EMAIL_* values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.gov.np
# Where the "verify your email" / "reset password" links in those emails
# point. Keep the default for local dev (vite on 5173); set it to your
# deployed site in production, e.g. FRONTEND_URL=https://your-domain.com
FRONTEND_URL=http://localhost:5173

# --- SMS (Twilio) -------------------------------------------------------
# Leave blank for "not configured" (honest no-op; OTP is logged for dev).
# Placeholder values (your_*) are ignored automatically.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_sender_number   # E.164, e.g. +15005550006 (your purchased Twilio number)
# SMS notes: user phone numbers are stored as E.164 (+977… for Nepal numbers).
# Twilio TRIAL accounts can only text numbers verified in the Twilio console;
# upgrade the account to reach any user. Queued SMS/email/push are delivered
# by an in-process background worker (NOTIFICATION_WORKER_ENABLED=1 default,
# every NOTIFICATION_WORKER_INTERVAL=60 s) with retries; set it to 0 only if
# a cron runs `python manage.py process_notification_queue` instead.
FCM_SERVER_KEY=your_fcm_server_key
FIREBASE_CREDENTIALS=your_firebase_credentials_json_or_path

# =====================================================================
# STANDALONE IMAGE SERVER
# =====================================================================
# Django stores only image PATHS in the DB (DestinationImage.image_path).
# The full URL = IMAGE_BASE_URL + /images/ + image_path and the binary is
# served by the standalone image server, never by Django.
#
# Development (run `python -m http.server 8000` inside image-server/):
IMAGE_BASE_URL=http://localhost:8000
#
# Production (Nginx serving image-server/images/ over HTTPS):
# IMAGE_BASE_URL=https://images.example.com
#
# Local root of the dataset used by `python manage.py import_images`:
# IMAGE_SERVER_ROOT=/absolute/path/to/image-server/images

# Optional authoritative normalized JSON feeds (leave blank until approved)
DHM_FEED_URL=
DHM_API_KEY=
BIPAD_FEED_URL=
BIPAD_API_KEY=
EXTERNAL_SYNC_TIMEOUT=15

# Optional road-routing service. Blank = straight-line distance only.
ROUTING_API_URL=
ROUTING_API_KEY=
LOCAL_GRAPH_ROUTING_ENABLED=True
LOCAL_GRAPH_MAX_SNAP_KM=100

# --- OAuth login (Google / GitHub) -----------------------------------
# How it works (read before editing):
#   1. The frontend redirects the browser to the provider's consent
#      screen. Google shows the ACCOUNT PICKER (prompt=select_account),
#      so any Google account signed in on the device can be chosen —
#      then the user is either signed in or a new account is created.
#   2. The provider sends the browser BACK TO THE FRONTEND:
#           <frontend origin>/auth/callback/google
#           <frontend origin>/auth/callback/github
#      ← THIS is the URI you must register with each provider.
#        (NOT the /api/v1/... URL — that endpoint is only called by the
#        frontend afterwards, via an in-page POST, so the browser never
#        visits it.)
#   3. The frontend hands the returned code to the backend, which
#      exchanges it with the CLIENT SECRET from this file, finds or
#      creates the account by email, and issues the normal JWT login.
#
# Put this file at:  Tourism/Tourism/.env   (next to manage.py — this
# .env.example's directory).  python-decouple reads it automatically;
# RESTART THE BACKEND after editing, then the Login/Sign-up page buttons
# light up automatically (client IDs are served via
# /api/v1/config/public/ → no frontend .env, no rebuild needed).
#
# Google (https://console.cloud.google.com/apis/credentials):
#   OAuth consent screen → add your email;
#   Credentials → Create OAuth client ID (Web application);
#   Authorized redirect URIs → add BOTH:
#     http://localhost:5173/auth/callback/google   (dev server)
#     https://<your-production-domain>/auth/callback/google
# GitHub (https://github.com/settings/developers → New OAuth App):
#   Authorization callback URL → add BOTH:
#     http://localhost:5173/auth/callback/github
#     https://<your-production-domain>/auth/callback/github
#   (GitHub apps do not need a client secret for the server-side
#   exchange used here, but fill GITHUB_CLIENT_SECRET anyway if you
#   create one — it is ignored when empty.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override: VITE_GOOGLE_CLIENT_ID / VITE_GITHUB_CLIENT_ID in
# frontend/Tourism/.env take precedence if set (then rebuild/restart the
# frontend dev server). Normally you do NOT need this.
