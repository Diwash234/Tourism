 "visa": {
  "source": "doi_visa",
  "tourist_visa_on_arrival": {
   "summary": "Tribhuvan International Airport (TIA) facilitates tourists with Visa on Arrival. You may also obtain a visa from Nepali Diplomatic Missions abroad prior to arrival.",
   "mission_visa_rule": "If you obtained a visa from a Nepalese Diplomatic Mission, you must enter Nepal within six months of the visa issue date. Your total stay is counted from the day you enter Nepal.",
   "fees_usd": [
    {
     "days": 15,
     "usd": 30
    },
    {
     "days": 30,
     "usd": 50
    },
    {
     "days": 90,
     "usd": 125
    }
   ],
   "steps": [
    "Fill in the Arrival Card and the Online Tourist Visa form (on the Department of Immigration website before arrival, or on kiosk machines at TIA). Print the submission receipt with barcode — valid for 15 days.",
    "Pay the visa fee (15 / 30 / 90 days) at the bank counter. Multiple payment modes accepted; carrying some cash is advised.",
    "Proceed to the immigration desk with your online form, payment receipt and passport."
   ],
   "apply_url": "https://nepaliport.immigration.gov.np/"
  },
  "gratis": [
   "Children below 10 years",
   "SAARC citizens (except Afghanistan) — up to 30 days on first visit in a given visa year",
   "NRN card holders",
   "Chinese Nationals"
  ],
  "contact": {
   "phone": "+977-1-4529660",
   "email": "info@immigration.gov.np",
   "hours": "Mon–Fri 09:00–17:00 (Magh 16 – Kartik 15); 09:00–16:00 (Kartik 16 – Magh 15)"
  },
  "gratis_note": "Summary of the Department of Immigration's gratis-visa list; check the source for full conditions."
