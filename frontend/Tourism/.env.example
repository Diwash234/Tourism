# Google Places
GOOGLE_MAPS_API_KEY=your_google_api_key

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key

# Foursquare
FOURSQUARE_API_KEY=your_foursquare_api_key

# Unsplash
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# Mapillary
VITE_MAPILLARY_ACCESS_TOKEN=your_mapillary_access_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# Google Places
GOOGLE_MAPS_API_KEY=your_google_api_key

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key

# Foursquare
FOURSQUARE_API_KEY=your_foursquare_api_key

# Unsplash
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Standalone image server base URL (optional for the frontend — the Django API
# already returns absolute image URLs built from the backend's IMAGE_BASE_URL).
# Only needed if the frontend must construct image-server URLs client-side.
VITE_IMAGE_BASE_URL=http://localhost:8000

# OAuth client IDs (PUBLIC values — safe in frontend code; the client
# SECRETS stay in the backend Tourism/.env only). Create the OAuth apps at:
#   Google: https://console.cloud.google.com/apis/credentials
#           -> OAuth client ID (Web application)
#           -> Authorized redirect URI: <your-origin>/auth/callback/google
#   GitHub: https://github.com/settings/developers
#           -> New OAuth App
#           -> Authorization callback URL: <your-origin>/auth/callback/github
# Dev example (vite dev server): http://localhost:5173/auth/callback/google
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
