    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
